{
  "name": "@heroku-cli/heroku-connect-plugin",
  "description": "Heroku Connect CLI plugin",
  "version": "0.13.5",
  "author": "Heroku",
  "repository": {
    "type": "git",
    "url": "https://github.com/heroku/heroku-connect-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/heroku/heroku-connect-plugin/issues"
  },
  "keywords": [
    "heroku-plugin"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc",
    "manifest": "oclif manifest",
    "readme": "oclif readme",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "CONNECT_ADDON=connectqa vitest run",
    "test:watch": "CONNECT_ADDON=connectqa vitest",
    "docs:generate": "npm run build && npm run manifest && oclif readme --output-dir docs --multi",
    "prepare": "npm run build && npm run manifest",
    "postpack": "rimraf oclif.manifest.json"
  },
  "files": [
    "dist",
    "oclif.manifest.json"
  ],
  "oclif": {
    "bin": "heroku",
    "commands": "./dist/commands",
    "repositoryPrefix": "<%- repo %>/blob/heroku-connect-plugin-v<%- version %>/<%- commandPath %>",
    "topics": {
      "connect": {
        "description": "Manage connections for Heroku Connect"
      },
      "connect:mapping": {
        "description": "Manage mappings on a Heroku Connect addon"
      },
      "connect:notifications": {
        "description": "Manage notifications on a Heroku Connect addon"
      }
    }
  },
  "dependencies": {
    "@heroku-cli/command": "^13.0.0",
    "@heroku/heroku-cli-util": "^10.9.2",
    "@oclif/core": "^4.8.4",
    "axios": "1.20.0",
    "inquirer": "^8.2.7"
  },
  "overrides": {
    "cross-spawn": "^6.0.6"
  },
  "devDependencies": {
    "@heroku-cli/test-utils": "^1.0.1",
    "@types/inquirer": "^8.2.10",
    "@types/node": "^26.6.2",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^9.39.4",
    "eslint-config-oclif": "^6.0.144",
    "eslint-plugin-vitest": "^0.5.4",
    "nock": "^14.0.10",
    "oclif": "^4.22.81",
    "rimraf": "^6.1.3",
    "sinon": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
